---
import "../styles/global.css";
import { profile } from "../data/profile";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${profile.name} — ${profile.role}`,
  description = profile.tagline,
} = Astro.props;

// A fully transparent placeholder — deliberately blank. Without an explicit
// og:image, link previews (iMessage, Slack, etc.) fall back to scanning the
// page and grabbing whatever photo they find first, which is not what we
// want for a personal site full of unrelated photos (Favorites section).
const ogImage = new URL("/og-blank.png", Astro.site);
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <title>{title}</title>

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body class="relative min-h-screen font-sans antialiased selection:bg-(--color-accent)">
    <div data-spotlight class="spotlight"></div>
    <slot />
    <script>
      import "../scripts/interactions.client";
    </script>
  </body>
</html>
