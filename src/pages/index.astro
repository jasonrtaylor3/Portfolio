---
import { Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import ProjectCard from "../components/ProjectCard.astro";
import CaseStudyArt from "../components/art/CaseStudyArt.astro";
import RagArt from "../components/art/RagArt.astro";
import { about, experience, projects } from "../data/profile";
import { favorites } from "../data/favorites";

const projectArt = {
  "case-study-library": CaseStudyArt,
  "rag-rfp": RagArt,
} as const;
---

<Layout>
  <main
    class="relative z-10 mx-auto flex max-w-6xl flex-col px-6 py-16 sm:px-12 lg:flex-row lg:items-start lg:gap-x-16 lg:px-12 lg:py-0"
  >
    <Header />

    <div class="min-w-0 lg:py-24">
      <section id="about" class="scroll-mt-24">
        <h2 class="tag mb-6 flex items-center gap-4 text-(--color-ink-bright)">
          <span class="text-(--color-accent)">01.</span>
          <span class="uppercase">About</span>
          <span class="h-px flex-1 bg-(--color-border)"></span>
        </h2>
        <div class="space-y-4 text-(--color-ink)">
          {about.map((p) => <p>{p}</p>)}
        </div>
      </section>

      <section id="experience" class="mt-20 scroll-mt-24">
        <h2 class="tag mb-6 flex items-center gap-4 text-(--color-ink-bright)">
          <span class="text-(--color-accent)">02.</span>
          <span class="uppercase">Experience</span>
          <span class="h-px flex-1 bg-(--color-border)"></span>
        </h2>
        <ol class="space-y-10">
          {
            experience.map((job) => (
              <li class="grid gap-1 sm:grid-cols-[140px_1fr] sm:gap-6">
                <p class="tag text-(--color-ink-dim)">{job.range}</p>
                <div>
                  <h3 class="font-medium text-(--color-ink-bright)">
                    {job.title} ·{" "}
                    {job.companyUrl === "#" ? (
                      <span class="text-(--color-accent)">{job.company}</span>
                    ) : (
                      <a
                        href={job.companyUrl}
                        target="_blank"
                        rel="noreferrer"
                        class="text-(--color-accent) hover:underline"
                      >
                        {job.company}
                      </a>
                    )}
                  </h3>
                  <p class="mt-2 text-sm text-(--color-ink-dim)">{job.summary}</p>
                </div>
              </li>
            ))
          }
        </ol>
      </section>

      <section id="projects" class="mt-20 scroll-mt-24">
        <h2 class="tag mb-6 flex items-center gap-4 text-(--color-ink-bright)">
          <span class="text-(--color-accent)">03.</span>
          <span class="uppercase">Projects</span>
          <span class="h-px flex-1 bg-(--color-border)"></span>
        </h2>
        <div class="grid gap-6 sm:grid-cols-2">
          {
            projects.map((p) => {
              const Art = projectArt[p.id];
              return (
                <ProjectCard {...p}>
                  <Art slot="art" />
                </ProjectCard>
              );
            })
          }
        </div>
      </section>

      <section id="favorites" class="mt-20 scroll-mt-24">
        <h2 class="tag mb-6 flex items-center gap-4 text-(--color-ink-bright)">
          <span class="text-(--color-accent)">04.</span>
          <span class="uppercase">Favorites</span>
          <span class="h-px flex-1 bg-(--color-border)"></span>
        </h2>
        <div class="space-y-10">
          {
            favorites.map((category) => (
              <div>
                <h3 class="tag mb-4 text-(--color-ink-dim)">{category.label.toUpperCase()}</h3>
                <div class="grid grid-cols-2 gap-5">
                  {category.items.map((item) => (
                    <figure>
                      <div class="aspect-[3/4] overflow-hidden rounded-lg border border-(--color-border) bg-(--color-bg-soft)">
                        <Image
                          src={item.image}
                          alt={item.name}
                          width={500}
                          class="h-full w-full object-cover object-top"
                        />
                      </div>
                      <figcaption class="mt-3">
                        <p class="font-medium text-(--color-ink-bright)">{item.name}</p>
                        <p class="mt-1 text-sm italic text-(--color-ink-dim)">{item.blurb}</p>
                        {"credit" in item && (
                          <p class="tag mt-1.5 text-(--color-ink-dim) opacity-60">{item.credit}</p>
                        )}
                      </figcaption>
                    </figure>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <footer class="mt-24 pb-16 text-sm text-(--color-ink-dim)">
        <p class="tag">Built with Astro &amp; Tailwind CSS.</p>
      </footer>
    </div>
  </main>
</Layout>
